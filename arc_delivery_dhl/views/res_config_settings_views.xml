<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_arc_dhl" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.arc.dhl</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@data-string='Sales']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">DHL Freight Sweden</span>
                        <div class="text-muted">
                            Configure the DHL Freight Sweden API Farm integration.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <label for="arc_dhl_api_key" class="o_form_label"/>
                                <field name="arc_dhl_api_key" password="True"/>
                            </div>
                            <div class="mt16">
                                <field name="arc_dhl_is_production"/>
                                <label for="arc_dhl_is_production" class="o_form_label"/>
                            </div>
                            <div class="mt16">
                                <label for="arc_dhl_force_environment" class="o_form_label"/>
                                <field name="arc_dhl_force_environment"/>
                            </div>
                            <div class="mt16">
                                <field name="arc_dhl_visualcutter_enabled"/>
                                <label for="arc_dhl_visualcutter_enabled" class="o_form_label"/>
                            </div>
                            <div class="mt16">
                                <field name="arc_dhl_booking_enabled"/>
                                <label for="arc_dhl_booking_enabled" class="o_form_label"/>
                            </div>
                            <div class="mt16">
                                <field name="arc_dhl_tracking_enabled"/>
                                <label for="arc_dhl_tracking_enabled" class="o_form_label"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
