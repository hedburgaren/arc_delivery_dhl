<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_arc_dhl" model="ir.ui.view">
        <field name="name">sale.order.form.arc.dhl</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_arc_package_proposal_create' and @type='object']" position="after">
                <button name="action_arc_dhl_quote" type="object" string="Get DHL freight quote" class="btn-secondary" invisible="state not in ('draft', 'sent')"/>
                <button name="action_arc_dhl_apply_shipping" type="object" string="Add freight line" class="btn-secondary" invisible="state not in ('draft', 'sent') or not arc_dhl_price_quote_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(arc_delivery_dhl.arc_dhl_price_quote_action)d" type="action" class="oe_stat_button" icon="fa-truck" invisible="not arc_dhl_price_quote_id">
                    <field name="arc_dhl_shipping_cost" widget="statinfo" string="DHL freight"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="DHL Freight" name="arc_dhl_freight" invisible="not arc_dhl_price_quote_id">
                    <group>
                        <group>
                            <field name="arc_dhl_price_quote_id"/>
                            <field name="arc_dhl_product_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="arc_dhl_shipping_cost"/>
                            <field name="arc_dhl_shipping_cost_incl_vat"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
