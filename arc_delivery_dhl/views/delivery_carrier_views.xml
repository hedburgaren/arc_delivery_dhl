<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_arc_dhl" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.arc.dhl</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <group name="delivery_details" position="inside">
                <group
                    string="DHL Freight Sweden"
                    invisible="delivery_type != 'dhl_freight_se'">
                    <field name="arc_dhl_product_id"/>
                    <field name="arc_dhl_service_text"/>
                    <field name="arc_dhl_default_sender_reference"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
