<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="arc_dhl_booking_list_view" model="ir.ui.view">
        <field name="name">arc.dhl.booking.list</field>
        <field name="model">arc.dhl.booking</field>
        <field name="arch" type="xml">
            <list string="DHL Bookings">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="state"/>
                <field name="dhl_booking_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="arc_dhl_booking_form_view" model="ir.ui.view">
        <field name="name">arc.dhl.booking.form</field>
        <field name="model">arc.dhl.booking</field>
        <field name="arch" type="xml">
            <form string="DHL Booking">
                <header>
                    <button name="action_book_shipment" type="object" string="Book Shipment"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,booked,error,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="carrier_id"/>
                            <field name="picking_id"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="dhl_booking_id"/>
                            <field name="dhl_tracking_numbers"/>
                            <field name="price"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <field name="error_message" readonly="1" class="alert alert-danger"
                           invisible="not error_message"/>
                    <notebook>
                        <page string="Labels">
                            <field name="label_ids">
                                <list string="Labels">
                                    <field name="name"/>
                                    <field name="tracking_number"/>
                                </list>
                            </field>
                        </page>
                        <page string="API">
                            <field name="api_request"/>
                            <field name="api_response"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="arc_dhl_booking_action" model="ir.actions.act_window">
        <field name="name">DHL Bookings</field>
        <field name="res_model">arc.dhl.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
